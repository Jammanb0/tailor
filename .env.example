# Claude API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 참고 코퍼스를 어떻게 넣을지 고르는 스위치. 없으면 full입니다.
#
#   full   (기본) 전체 코퍼스를 Sonnet에 그대로 넣습니다. 모델 처리 1단계.
#   routed 최초 생성에 한해 Haiku가 필요한 패턴 묶음을 먼저 고르고,
#          고른 것만 Sonnet에 넣습니다. 모델 처리 2단계.
#
# `routed`가 아닌 값(오타 포함)은 전부 full로 해석합니다. 수정 요청은 설정과
# 무관하게 늘 full입니다. 네트워크·deadline·5xx·분류되지 않은 요청 오류나
# 선택 후처리 실패는 full로 돌아가고, 결제·사용량·인증·429 오류는 중단합니다.
CORPUS_ROUTING_MODE=

# 운영 계측을 저장할 Supabase. 없으면 계측만 건너뛰고 스킬 생성은 그대로
# 동작합니다(fail-open).
#
# 표를 만드는 SQL은 `docs/operations/generations-table.sql`에 있습니다.
# 관찰 계획과 저장 필드의 근거는
# `docs/experiments/data/2026-08-31-routed-operations/PRE-REGISTRATION.md`입니다.
#
# 키는 **서버 전용 시크릿 키**입니다. 표에 RLS를 켜고 정책을 두지 않았으므로
# publishable(anon) 키로는 읽지도 쓰지도 못합니다.
# `NEXT_PUBLIC_` 접두사를 붙이지 마세요 — 클라이언트 번들에 그대로 들어갑니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
