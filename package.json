{
	"name": "tailor",
	"version": "0.1.1",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:corpus": "node --experimental-strip-types --no-warnings tools/lint-corpus.mjs",
		"check:corpus-render": "node tools/check-corpus-render.mjs",
		"format": "biome check --write .",
		"count:audit": "node --experimental-strip-types --no-warnings tools/count-audit-coverage.mjs",
		"check:parser": "node tools/check-tag-parser.mjs",
		"check:logging": "node --experimental-strip-types --no-warnings --import ./tools/alias-loader.mjs tools/check-logging.mjs",
		"check:upstream-errors": "node --experimental-strip-types --no-warnings --import ./tools/alias-loader.mjs tools/check-upstream-errors.mjs",
		"check:input-limits": "node --experimental-strip-types --no-warnings --import ./tools/alias-loader.mjs tools/check-input-limits.mjs",
		"check:routing": "node tools/check-routing.mjs",
		"check:routing-production": "node --experimental-strip-types --no-warnings tools/check-production-routing.mjs",
		"preview:routing": "node tools/route-preview.mjs",
		"check:routing-eval": "node --experimental-strip-types --no-warnings tools/evaluate-routing.mjs validate",
		"run:routing-eval:selection": "node --experimental-strip-types --no-warnings tools/evaluate-routing.mjs run-selection",
		"run:routing-eval:generation": "node --experimental-strip-types --no-warnings tools/evaluate-routing.mjs run-generation",
		"check:routing-comparison": "node tools/evaluate-routing-comparison.mjs validate",
		"run:routing-comparison:quality": "node tools/evaluate-routing-comparison.mjs run-quality",
		"run:routing-comparison:e2e": "node tools/evaluate-routing-comparison.mjs run-e2e",
		"report:routing-comparison": "node tools/evaluate-routing-comparison.mjs summarize",
		"check:routing-fallback": "node tools/evaluate-routing-fallback.mjs run-free",
		"run:routing-fallback:generation": "node tools/evaluate-routing-fallback.mjs run-paid"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.116.0",
		"framer-motion": "^13.1.0",
		"gsap": "^3.15.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "pnpm@10.11.0"
}
